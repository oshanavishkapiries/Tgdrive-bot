# Copy this file to .env and fill in real values. Never commit .env.

# --- Telegram (get from https://my.telegram.org/apps) ---
APP_ID=
API_HASH=

# --- Telegram bot token (get from https://t.me/BotFather) ---
BOT_TOKEN=

# --- Google Drive OAuth client (get from https://console.cloud.google.com/apis/credentials) ---
# Create an OAuth 2.0 Client ID of type "Web application", enable the Google
# Drive API for the project, and paste the client id/secret here.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# The Cloudflare Worker URL that catches Google's OAuth redirect (see
# cloudflare-worker/worker.js). Must exactly match an "Authorized redirect URI"
# on the Google Cloud OAuth client above.
GDRIVE_REDIRECT_URI=

# --- Database ---
# Path to the SQLite database file. Relative paths are resolved from the project root.
DATABASE_PATH=data/bot.db
